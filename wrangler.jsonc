{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sharing-time-prayers",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "PRAYER_KV",
      "id": "e5cf8e28607b4c738250dd92c8683495"
    }
  ]
}
